# HTTP server
PORT=3000

# Public base URL this server is reachable at (used for OAuth issuer/metadata
# and as the fixed Microsoft redirect_uri: <MCP_BASE_URL>/oauth/microsoft/callback)
MCP_BASE_URL=https://mcp.yourdomain.example

# Bare domain (no protocol) - used by Caddy (see Caddyfile) to request its TLS certificate.
MCP_DOMAIN=mcp.yourdomain.example

# Azure App Registration (https://portal.azure.com -> App registrations -> New registration
# -> Supported account types: "Accounts in any organizational directory and personal Microsoft
# accounts". Add a Web platform redirect URI: <MCP_BASE_URL>/oauth/microsoft/callback)
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT=common

# SQLite token store
DB_PATH=./data/tokens.sqlite

# 32-byte (base64) key used for AES-256-GCM encryption of stored Microsoft tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# Optional shared secret that Dynamic Client Registration (POST /register) callers must
# present as `Authorization: Bearer <DCR_BOOTSTRAP_TOKEN>`. Leave empty to allow open
# registration (fine for local testing, NOT recommended for a public deployment).
DCR_BOOTSTRAP_TOKEN=
